    m_TransformParent: {fileID: 2183478209534672083}
    m_Modifications:
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: myText
      value: 
      objectReference: {fileID: 5275437812004411494}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: pageNumber
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[0]
      value: "4a. <indent=5%>The angle of deflection between the incoming and outgoing
        quanta of radiation should then satisfy:\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a</i></b>\r\n </align>and \r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[1]
      value: "<size=110%>4a. <indent=5%>\u3053\u306E\u3068\u304D\u3001\u5165\u5C04\u3059\u308B\u653E\u5C04\u91CF\u5B50\u3068\u51FA\u5C04\u3059\u308B\u653E\u5C04\u91CF\u5B50\u3068\u306E\u9593\u306E\u504F\u5411\u89D2\u306F\u3001\u4EE5\u4E0B\u306E\u95A2\u4FC2\u3092\u6E80\u305F\u3059\u5FC5\u8981\u304C\u3042\u308B\u3002\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a</i></b>\r\n</align>\u304A\u3088\u3073\r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[2]
      value: "<size=110%>4a. \u5165\u5C04\u8207\u51FA\u5C04\u8F3B\u5C04\u91CF\u5B50\u4E4B\u9593\u7684\u504F\u8F49\u89D2\u61C9\u6EFF\u8DB3\uFF1A\r\n\r\nhf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a\r\n\r\n\u4E14\r\nhf/c(sin(\u03B8)-sin(\u03B8')) = \u03C4'h/b"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[3]
      value: "<size=110%>4a. <indent=5%>\u6B64\u65F6\uFF0C\u5165\u5C04\u8F90\u5C04\u91CF\u5B50\u4E0E\u51FA\u5C04\u8F90\u5C04\u91CF\u5B50\u4E4B\u95F4\u7684\u504F\u8F6C\u89D2\u5E94\u6EE1\u8DB3\uFF1A\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a</i></b>\r\n</align>\u4EE5\u53CA\r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[4]
      value: "<size=110%>4a. <indent=5%>\uC774\uB54C \uC785\uC0AC\uD558\uB294 \uBCF5\uC0AC
        \uC591\uC790\uC640 \uBC29\uCD9C\uB418\uB294 \uBCF5\uC0AC \uC591\uC790 \uC0AC\uC774\uC758
        \uD3B8\uD5A5\uAC01\uC740 \uB2E4\uC74C \uAD00\uACC4\uC2DD\uC744 \uB9CC\uC871\uD574\uC57C
        \uD55C\uB2E4:\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8')) =\u03C4h/a</i></b>\r\n</align>\uADF8\uB9AC\uACE0\r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[5]
      value: "4a. <indent=5%>O \xE2ngulo de deflex\xE3o entre os quanta de radia\xE7\xE3o
        incidentes e emergentes deve, ent\xE3o, satisfazer:\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a</i></b>\r\n</align>e\r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: texts.Array.data[6]
      value: "4a. <indent=5%>L'angle de d\xE9viation entre les quanta de rayonnement
        incidents et sortants doit alors satisfaire aux relations suivantes :\r\n\r\n<align=center><b><i>hf/c(cos(\u03B8)-cos(\u03B8'))
        =\u03C4h/a</i></b>\r\n</align>et\r\n<align=center><b><i>hf/c(sin(\u03B8)-sin(\u03B8'))
        = \u03C4'h/b</i></b>\r\n</align>"
      objectReference: {fileID: 0}
    - target: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 6414034894882094808, guid: 1cc37ac5ee978fa4394ff48b2cb53d43,
        type: 3}
