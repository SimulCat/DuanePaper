        type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8781997057255461638, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: myText
      value: 
      objectReference: {fileID: 5275437812004411494}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[0]
      value: "3e. <indent=5%>Following this reasoning, Duane postulates candidate
        equations for the momentum an X-ray can exchange with the lattice:\r\n<align=center>\r\n<size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n</align>and \r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n</align>\r\nwhere <b>\u03C4</b> and <b>\u03C4'</b>
        are integer constants. "
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[1]
      value: "<size=110%>3e. <indent=5%>\u3053\u306E\u8AD6\u7406\u306B\u5F93\u3044\u3001\u30C7\u30E5\u30A2\u30F3\uFF08Duane\uFF09\u306F\u3001X\u7DDA\u304C\u7D50\u6676\u683C\u5B50\u3068\u4EA4\u63DB\u3057\u3046\u308B\u904B\u52D5\u91CF\u306B\u3064\u3044\u3066\u3001\u4EE5\u4E0B\u306E\u5F0F\u3092\u5019\u88DC\u3068\u3057\u3066\u63D0\u793A\u3057\u3066\u3044\u308B\u3002\r\n<align=center><size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n</align>\u304A\u3088\u3073\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></size>\r\n</align>\u3053\u3053\u3067\u3001<b>\u03C4</b>
        \u304A\u3088\u3073 <b>\u03C4'</b> \u306F\u6574\u6570\u5B9A\u6570\u3067\u3042\u308B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[2]
      value: "<size=110%>3e. <indent=5%>\u57FA\u65BC\u6B64\u63A8\u7406\uFF0C\u675C\u5B89\u5047\u8A2D\u4E86X\u5C04\u7DDA\u8207\u6676\u683C\u4EA4\u63DB\u52D5\u91CF\u7684\u5019\u9078\u65B9\u7A0B\u5F0F\uFF1A\r\n\r\n<align=center><size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n\r\n</align>\u4EE5\u53CA\r\n\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n\r\n</align>\u5176\u4E2D<b>\u03C4</b>\u548C<b>\u03C4'</b>\u662F\u6574\u6578\u5E38\u6578\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[3]
      value: "<size=110%>3e. <indent=5%>\u57FA\u4E8E\u8FD9\u4E00\u63A8\u8BBA\uFF0CDuane
        \u63D0\u51FA\u4E86\u5173\u4E8E X \u5C04\u7EBF\u4E0E\u6676\u683C\u4E4B\u95F4\u53EF\u4EA4\u6362\u52A8\u91CF\u7684\u5019\u9009\u65B9\u7A0B\uFF1A\r\n<align=center><size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n</align>\u4EE5\u53CA\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n</align>\u5176\u4E2D <b>\u03C4</b> \u548C <b>\u03C4'</b>
        \u4E3A\u6574\u6570\u5E38\u6570\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[4]
      value: "<size=110%>3e. <indent=5%>\uC774\uB7EC\uD55C \uB17C\uB9AC\uC5D0 \uB530\uB77C,
        \uB4C0\uC564(Duane)\uC740 X\uC120\uC774 \uACA9\uC790\uC640 \uAD50\uD658\uD560
        \uC218 \uC788\uB294 \uC6B4\uB3D9\uB7C9\uC5D0 \uB300\uD55C \uD6C4\uBCF4 \uBC29\uC815\uC2DD\uB4E4\uC744
        \uB2E4\uC74C\uACFC \uAC19\uC774 \uAC00\uC815\uD55C\uB2E4:\r\n<align=center><size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n</align>\uBC0F\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n</align>\uC5EC\uAE30\uC11C <b>\u03C4</b>\uC640
        <b>\u03C4'</b>\uB294 \uC815\uC218 \uC0C1\uC218\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[5]
      value: "3e. <indent=5%>Seguindo esse racioc\xEDnio, Duane postula equa\xE7\xF5es
        candidatas para o momento que um raio X pode trocar com a rede cristalina:\r\n<align=center><size=110%><b>M<sub>x</sub>
        = \u03C4h/a</b></size>\r\n</align>e\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n</align>onde <b>\u03C4</b> e <b>\u03C4'</b> s\xE3o
        constantes inteiras."
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: texts.Array.data[6]
      value: "3e. <indent=5%>En suivant ce raisonnement, Duane propose des \xE9quations
        candidates pour l'impulsion qu'un rayon X peut \xE9changer avec le r\xE9seau
        :\r\n<align=center><size=110%><b>M<sub>x</sub> = \u03C4h/a</b></size>\r\n</align>et\r\n<align=center><size=110%><b>M<sub>y</sub>
        = \u03C4'h/b</b></align>\r\n</align>o\xF9 <b>\u03C4</b> et <b>\u03C4'</b>
        sont des constantes enti\xE8res."
      objectReference: {fileID: 0}
    - target: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 9175124464448754422, guid: af7fdf9f07f2fce4cacb40a1c8eb57ca,
        type: 3}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
