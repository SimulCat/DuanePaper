    - target: {fileID: 1752285292130994097, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: m_Name
      value: D02 notes Page3
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: myText
      value: 
      objectReference: {fileID: 5275437812004411494}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: pageNumber
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[1]
      value: "3d. <indent=5%>\u3053\u3053\u3067\u30C7\u30E5\u30A2\u30F3\uFF08Duane\uFF09\u306F\u3001\u683C\u5B50\u306B\u304A\u3051\u308B\u76F8\u4E92\u4F5C\u7528\u306E\u5927\u304D\u3055\u304C\u3001\u30D7\u30E9\u30F3\u30AF\u5B9A\u6570
        <b>h</b> \u3092\u8DDD\u96E2\u3067\u5272\u3063\u305F\u5024\u306B\u6BD4\u4F8B\u3059\u308B\u5358\u4F4D\u3067\u91CF\u5B50\u5316\u3055\u308C\u3066\u3044\u308B\u3068\u63D0\u6848\u3057\u3066\u3044\u308B\u3002\r\n<b>x</b>
        \u65B9\u5411\u306E\u9762\u9593\u9694\u304C <b>a</b> \u3067\u3042\u308B\u5834\u5408\u3001<b>M<sub>x</sub></b>
        \u306F\u4EE5\u4E0B\u306E\u5024\u306E\u307F\u3092\u3068\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\r\n<align=center><b>M<sub>x</sub>
        = \u03C4h/a</b>\r\n</align>\u307E\u305F\u3001\u9593\u9694\u304C <b>b</b>
        \u3067\u3042\u308B <b>y</b> \u65B9\u5411\u306E\u904B\u52D5\u91CF\u6210\u5206
        <b>M<sub>y</sub></b> \u306B\u3064\u3044\u3066\u3082\u3001\u4EE5\u4E0B\u306E\u5024\u306E\u307F\u3092\u3068\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\r\n<align=center><b>M<sub>y</sub>
        = \u03C4'h/b</b>\r\n</align>\u3053\u3053\u3067\u3001<b>\u03C4</b> \u304A\u3088\u3073
        <b>\u03C4'</b> \u306F\u5B9A\u6570\u3067\u3042\u308B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[2]
      value: "<size=110%>3d. \u675C\u5B89\u5728\u6B64\u63D0\u51FA\uFF0C\u6676\u683C\u4EA4\u4E92\u4F5C\u7528\u7684\u5F37\u5EA6\u662F\u91CF\u5B50\u5316\u7684\uFF0C\u5176\u55AE\u4F4D\u8207\u666E\u6717\u514B\u5E38\u6578
        h \u9664\u4EE5\u8DDD\u96E2\u6210\u6B63\u6BD4\u3002\r\n\r\n\u82E5 x \u65B9\u5411\u7684\u5E73\u9762\u9593\u8DDD\u70BA
        a\uFF0C\u5247 M<sub>x</sub> \u53EA\u80FD\u53D6\u4E0B\u5217\u503C\uFF1A\r\n\r\nM<sub>x</sub>
        = \u03C4h/a\r\n\r\ny \u65B9\u5411\u7684\u52D5\u91CF\u70BA b\uFF0C\u5247 M<sub>y</sub>
        \u53EA\u80FD\u53D6\u4E0B\u5217\u503C\uFF1A\r\n\r\nM<sub>y</sub> = \u03C4'h/b\r\n\r\n\u5176\u4E2D
        \u03C4 \u548C \u03C4' \u70BA\u5E38\u6578\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[3]
      value: "<size=110%>3d. <indent=5%>\u5728\u6B64\uFF0CDuane \u63D0\u51FA\uFF0C\u6676\u683C\u76F8\u4E92\u4F5C\u7528\u7684\u5927\u5C0F\u662F\u91CF\u5B50\u5316\u7684\uFF0C\u5176\u5355\u4F4D\u4E0E\u666E\u6717\u514B\u5E38\u6570
        <b>h</b> \u9664\u4EE5\u67D0\u6BB5\u8DDD\u79BB\u6240\u5F97\u7684\u6570\u503C\u6210\u6B63\u6BD4\u3002\r\n\u82E5
        <b>x</b> \u65B9\u5411\u4E0A\u7684\u6676\u9762\u95F4\u8DDD\u4E3A <b>a</b>\uFF0C\u5219
        <b>M<sub>x</sub></b> \u4EC5\u80FD\u53D6\u4EE5\u4E0B\u6570\u503C\uFF1A\r\n<align=center><b>M<sub>x</sub>
        = \u03C4h/a</b>\r\n</align>\u540C\u7406\uFF0C\u5BF9\u4E8E <b>y</b> \u65B9\u5411\uFF08\u95F4\u8DDD\u4E3A
        <b>b</b>\uFF09\u4E0A\u7684\u52A8\u91CF\uFF0C<b>M<sub>y</sub></b> \u4EC5\u80FD\u53D6\u4EE5\u4E0B\u6570\u503C\uFF1A\r\n<align=center><b>M<sub>y</sub>
        = \u03C4'h/b</b>\r\n</align>\u5176\u4E2D <b>\u03C4</b> \u548C <b>\u03C4'</b>
        \u4E3A\u5E38\u6570\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[4]
      value: "3d. <indent=5%>\uC774 \uC2DC\uC810\uC5D0\uC11C \uB4C0\uC564(Duane)\uC740
        \uACA9\uC790 \uC0C1\uD638\uC791\uC6A9\uC758 \uD06C\uAE30\uAC00 \uD50C\uB791\uD06C
        \uC0C1\uC218 <b>h</b>\uB97C \uAC70\uB9AC\uB85C \uB098\uB208 \uAC12\uC5D0
        \uBE44\uB840\uD558\uB294 \uB2E8\uC704\uB85C \uC591\uC790\uD654\uB41C\uB2E4\uACE0
        \uC81C\uC548\uD55C\uB2E4.\r\n<b>x</b> \uBC29\uD5A5\uC758 \uBA74 \uAC04\uACA9\uC774
        <b>a</b>\uB77C\uBA74, <b>M<sub>x</sub></b>\uB294 \uB2E4\uC74C\uACFC \uAC19\uC740
        \uAC12\uB9CC\uC744 \uAC00\uC9C8 \uC218 \uC788\uB2E4:\r\n<align=center><b>M<sub>x</sub>
        = \u03C4h/a</b>\r\n</align>\uB610\uD55C \uAC04\uACA9\uC774 <b>b</b>\uC778
        <b>y</b> \uBC29\uD5A5\uC758 \uC6B4\uB3D9\uB7C9\uC5D0 \uB300\uD574, <b>M<sub>y</sub></b>\uB294
        \uB2E4\uC74C\uACFC \uAC19\uC740 \uAC12\uB9CC\uC744 \uAC00\uC9C8 \uC218 \uC788\uB2E4:\r\n<align=center><b>M<sub>y</sub>
        = \u03C4'h/b</b>\r\n</align>\uC5EC\uAE30\uC11C <b>\u03C4</b>\uC640 <b>\u03C4'</b>\uB294
        \uC0C1\uC218\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[5]
      value: "3d. <indent=5%>Neste ponto, Duane prop\xF5e que as magnitudes das intera\xE7\xF5es
        da rede sejam quantizadas em unidades proporcionais \xE0 constante de Planck
        <b>h</b> dividida por uma dist\xE2ncia.\r\nSe o espa\xE7amento entre planos
        na dire\xE7\xE3o <b>x</b> for <b>a</b>, ent\xE3o <b>M<sub>x</sub></b> s\xF3
        pode assumir os valores:\r\n<align=center><b>M<sub>x</sub> = \u03C4h/a</b>\r\n</align>e,
        para o momento na dire\xE7\xE3o <b>y</b>, com espa\xE7amento <b>b</b>, <b>M<sub>y</sub></b>
        s\xF3 pode assumir os valores:\r\n<align=center><b>M<sub>y</sub> = \u03C4'h/b</b>\r\n</align> 
        onde <b>\u03C4</b> e <b>\u03C4'</b> s\xE3o constantes."
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: texts.Array.data[6]
      value: "3d. <indent=5%>\xC0 ce stade, Duane propose que les grandeurs des interactions
        au sein du r\xE9seau soient quantifi\xE9es en unit\xE9s proportionnelles
        \xE0 la constante de Planck <b>h</b> divis\xE9e par une distance.\r\nSi l'espacement
        des plans dans la direction <b>x</b> est \xE9gal \xE0 <b>a</b>, alors <b>M<sub>x</sub></b>
        ne peut prendre que les valeurs suivantes :\r\n<align=center><b>M<sub>x</sub>
        = \u03C4h/a</b>\r\n</align>et, pour l'impulsion dans la direction <b>y</b>
        avec un espacement <b>b</b>, <b>M<sub>y</sub></b> ne peut prendre que les
        valeurs suivantes :\r\n<align=center><b>M<sub>y</sub> = \u03C4'h/b</b>\r\n</align> 
        o\xF9 <b>\u03C4</b> et <b>\u03C4'</b> sont des constantes."
      objectReference: {fileID: 0}
    - target: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
      propertyPath: serializationData.Prefab
      value: 
      objectReference: {fileID: 5580472674785621444, guid: 2d4ad37932f4c6248bcd53965b615c99,
        type: 3}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 2d4ad37932f4c6248bcd53965b615c99, type: 3}
